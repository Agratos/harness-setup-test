{
  "scenarios": [
    {
      "name": "검색·즐겨찾기 필터·통계",
      "steps": [
        { "fill": { "label": "제목", "value": "React 공식문서" } },
        { "fill": { "label": "URL", "value": "https://react.dev" } },
        { "click": { "text": "추가" } },
        { "fill": { "label": "제목", "value": "Mantine" } },
        { "fill": { "label": "URL", "value": "https://mantine.dev" } },
        { "click": { "text": "추가" } },
        { "fill": { "label": "제목", "value": "Zustand" } },
        { "fill": { "label": "URL", "value": "https://github.com/pmndrs/zustand" } },
        { "click": { "text": "추가" } },
        { "assert": "minCount", "selector": ".mantine-Card-root", "expect": 3 },
        { "fill": { "label": "검색", "value": "Mantine" } },
        { "assert": "textVisible", "text": "Mantine" },
        { "assert": "textGone", "text": "Zustand" },
        { "fill": { "label": "검색", "value": "" } },
        { "assert": "minCount", "selector": ".mantine-Card-root", "expect": 3 },
        { "click": { "text": "즐겨찾기" } },
        { "check": { "name": "즐겨찾기만" } },
        { "assert": "textVisible", "text": "Zustand" },
        { "assert": "textGone", "text": "React 공식문서" },
        { "assert": "minCount", "selector": ".mantine-Card-root", "expect": 1 },
        { "uncheck": { "name": "즐겨찾기만" } },
        { "assert": "minCount", "selector": ".mantine-Card-root", "expect": 3 }
      ]
    }
  ]
}
